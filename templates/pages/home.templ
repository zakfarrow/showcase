package pages

import (
	"showcase/internal/model"
	"showcase/templates/layout"
)

templ Home(projects []model.Project, statuses []string, technologies []string, activeStatus string, activeTech string) {
	@layout.Base("Showcase") {
		<main class="w-full max-w-5xl mx-auto px-6 py-16">
			<p class="text-[11px] font-mono tracking-widest text-stone-400 uppercase mb-2">
				Portfolio
			</p>
			<h1 class="text-5xl font-normal text-stone-900 mb-1">
				My Projects
			</h1>
			<p class="text-stone-500 text-[15px] mb-6">
				A collection of things I've built.
			</p>
			<div id="projects-section">
				@ProjectFilters(statuses, technologies, activeStatus, activeTech)
				@ProjectGrid(projects)
			</div>
		</main>
	}
}

templ ProjectFilters(statuses []string, technologies []string, activeStatus string, activeTech string) {
	<form
		class="flex flex-wrap gap-3 mb-8"
		hx-get="/"
		hx-target="#projects-section"
		hx-select="#projects-section > *"
		hx-swap="innerHTML"
		hx-push-url="true"
	>
		<select
			name="status"
			class="text-sm px-3 py-2 bg-white border border-stone-200 rounded-lg text-stone-700 focus:outline-none focus:ring-2 focus:ring-stone-300 focus:border-stone-300"
			hx-trigger="change"
			hx-get="/"
			hx-include="[name='tech']"
			hx-target="#projects-section"
			hx-select="#projects-section > *"
			hx-swap="innerHTML"
			hx-push-url="true"
		>
			<option value="">All Statuses</option>
			for _, s := range statuses {
				<option value={ s } selected?={ s==activeStatus }>{ statusLabel(s) }</option>
			}
		</select>
		<select
			name="tech"
			class="text-sm px-3 py-2 bg-white border border-stone-200 rounded-lg text-stone-700 focus:outline-none focus:ring-2 focus:ring-stone-300 focus:border-stone-300"
			hx-trigger="change"
			hx-get="/"
			hx-include="[name='status']"
			hx-target="#projects-section"
			hx-select="#projects-section > *"
			hx-swap="innerHTML"
			hx-push-url="true"
		>
			<option value="">All Technologies</option>
			for _, t := range technologies {
				<option value={ t } selected?={ t==activeTech }>{ t }</option>
			}
		</select>
		if activeStatus != "" || activeTech != "" {
			<a href="/" class="text-sm px-3 py-2 text-stone-500 hover:text-stone-700 transition-colors">Clear filters</a>
		}
	</form>
}

templ ProjectGrid(projects []model.Project) {
	<div class="w-full grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
		for _, project := range projects {
			@ProjectCard(project)
		}
		if len(projects) == 0 {
			<p class="text-stone-500 col-span-full text-center py-8">No projects found matching your filters.</p>
		}
	</div>
}

templ ProjectCard(project model.Project) {
	<a
		href={ templ.SafeURL("/projects/" + project.Slug) }
		class="block bg-white rounded-lg border border-stone-200 p-6 hover:shadow-md hover:border-stone-300 transition-all"
	>
		<div class="flex items-start justify-between gap-2 mb-2">
			<h3 class="font-medium text-stone-900">{ project.Title }</h3>
			@StatusBadge(project.Status)
		</div>
		<p class="text-stone-500 text-sm mb-4">{ project.Description }</p>
		if len(project.TechStack) > 0 {
			<div class="flex flex-wrap gap-1.5">
				for _, tech := range project.TechStack {
					<span class="text-[10px] font-mono px-2 py-0.5 bg-stone-100 text-stone-600 rounded">{ tech }</span>
				}
			</div>
		}
	</a>
}

templ StatusBadge(status string) {
	switch status {
		case "completed":
			<span class="text-[10px] font-medium px-2 py-0.5 bg-green-100 text-green-700 rounded-full">Completed</span>
		case "in-progress":
			<span class="text-[10px] font-medium px-2 py-0.5 bg-blue-100 text-blue-700 rounded-full">In Progress</span>
		case "planned":
			<span class="text-[10px] font-medium px-2 py-0.5 bg-amber-100 text-amber-700 rounded-full">Planned</span>
		default:
			<span class="text-[10px] font-medium px-2 py-0.5 bg-stone-100 text-stone-600 rounded-full">{ status }</span>
	}
}

func statusLabel(status string) string {
	switch status {
	case "completed":
		return "Completed"
	case "in-progress":
		return "In Progress"
	case "planned":
		return "Planned"
	default:
		return status
	}
}
