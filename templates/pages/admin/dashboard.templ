package admin

import (
	"fmt"
	"showcase/internal/auth"
	"showcase/internal/model"
	"showcase/templates/layout"
)

templ Dashboard(projects []model.Project, user *auth.SessionUser) {
	@layout.Admin("Dashboard", user) {
		<div class="flex items-center justify-between mb-8">
			<h1 class="text-2xl font-medium text-stone-900">Projects</h1>
			<a
				href="/admin/projects/new"
				class="px-4 py-2 bg-stone-900 text-white text-sm font-medium rounded-lg hover:bg-stone-800 transition-colors"
			>
				New Project
			</a>
		</div>
		if len(projects) == 0 {
			<div class="text-center py-12 text-stone-500">
				<p>No projects yet.</p>
				<a href="/admin/projects/new" class="text-stone-900 underline">Create your first project</a>
			</div>
		} else {
			<div class="bg-white rounded-lg border border-stone-200 overflow-hidden">
				<table class="w-full">
					<thead class="bg-stone-50 border-b border-stone-200">
						<tr>
							<th class="text-left text-xs font-medium text-stone-500 uppercase tracking-wider px-4 py-3">Title</th>
							<th class="text-left text-xs font-medium text-stone-500 uppercase tracking-wider px-4 py-3">Status</th>
							<th class="text-left text-xs font-medium text-stone-500 uppercase tracking-wider px-4 py-3">Order</th>
							<th class="text-right text-xs font-medium text-stone-500 uppercase tracking-wider px-4 py-3">Actions</th>
						</tr>
					</thead>
					<tbody class="divide-y divide-stone-200">
						for _, project := range projects {
							<tr class="hover:bg-stone-50">
								<td class="px-4 py-3">
									<div class="flex items-center gap-2">
										<span class="font-medium text-stone-900">{ project.Title }</span>
										if project.Featured {
											<span class="text-[10px] px-1.5 py-0.5 bg-amber-100 text-amber-700 rounded">Featured</span>
										}
									</div>
									<div class="text-sm text-stone-500">{ project.Slug }</div>
								</td>
								<td class="px-4 py-3">
									@StatusBadge(project.Status)
								</td>
								<td class="px-4 py-3 text-sm text-stone-600">
									{ fmt.Sprintf("%d", project.SortOrder) }
								</td>
								<td class="px-4 py-3 text-right">
									<div class="flex items-center justify-end gap-2">
										<a
											href={ templ.SafeURL(fmt.Sprintf("/projects/%s", project.Slug)) }
											class="text-sm text-stone-500 hover:text-stone-700"
											target="_blank"
										>
											View
										</a>
										<a
											href={ templ.SafeURL(fmt.Sprintf("/admin/projects/%d/edit", project.ID)) }
											class="text-sm text-blue-600 hover:text-blue-800"
										>
											Edit
										</a>
										<form
											action={ templ.SafeURL(fmt.Sprintf("/admin/projects/%d/delete", project.ID)) }
											method="POST"
											onsubmit="return confirm('Are you sure you want to delete this project?')"
											class="inline"
										>
											<button type="submit" class="text-sm text-red-600 hover:text-red-800">
												Delete
											</button>
										</form>
									</div>
								</td>
							</tr>
						}
					</tbody>
				</table>
			</div>
		}
	}
}

templ StatusBadge(status string) {
	switch status {
		case "completed":
			<span class="text-xs px-2 py-0.5 bg-green-100 text-green-700 rounded-full">Completed</span>
		case "in-progress":
			<span class="text-xs px-2 py-0.5 bg-blue-100 text-blue-700 rounded-full">In Progress</span>
		case "planned":
			<span class="text-xs px-2 py-0.5 bg-amber-100 text-amber-700 rounded-full">Planned</span>
		default:
			<span class="text-xs px-2 py-0.5 bg-stone-100 text-stone-600 rounded-full">{ status }</span>
	}
}
